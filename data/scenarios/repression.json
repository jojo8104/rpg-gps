        {
          "type": "showNarration",
          "text": "Le dernier rempart cède. Votre corps tombe parmi les défenseurs. Sous votre forme de spectre, vous reprenez le chemin de la capitale. Là-bas, quelqu’un attend déjà de vous demander des comptes.",
          "scene": "siege",
          "speaker": "La défaite"
        }
      ]
