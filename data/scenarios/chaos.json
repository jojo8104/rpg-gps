  "phases": [
    { "id": "reach-royal-camp", "title": "Les prospecteurs disparus", "description": "Éloignez-vous du point de départ pour rejoindre le camp royal de Valgrise.", "objectives": [{ "id": "reach-royal-camp", "text": "Rejoindre le camp royal", "trigger": { "type": "locationPlaced", "locationSlotId": "royal-camp" }, "eventId": "royal-camp-reached" }], "eventIds": ["royal-camp-reached"], "transitions": [{ "nextPhase": "speak-to-camp-chief" }] },
    { "id": "speak-to-camp-chief", "title": "Les prospecteurs disparus", "description": "Armand de Valgrise vous attend dans la tente de commandement.", "objectives": [{ "id": "speak-to-camp-chief", "text": "Parler au chef du camp", "trigger": { "type": "interactionCompleted", "interactionId": "speak-to-camp-chief", "locationSlotId": "royal-camp", "label": "Questionner Armand sur les prospecteurs", "responseLines": ["Ils étaient six, accompagnés d’un jeune géologue.", "Ils devaient relever le terrain autour des anciennes collines minières et rentrer avant la nuit.", "Nous avons retrouvé leurs premières marques sur le chemin, puis plus rien.", "Suivez leurs traces. Retrouvez mes hommes si vous le pouvez."] }, "eventId": "camp-chief-questioned" }], "eventIds": ["camp-chief-questioned"], "transitions": [{ "nextPhase": "follow-first-trace" }] },
    { "id": "follow-first-trace", "title": "Les traces des prospecteurs", "description": "Approchez-vous du marqueur de piste et examinez les empreintes.", "objectives": [{ "id": "inspect-first-trace", "text": "Examiner les premières traces", "trigger": { "type": "trailPointInspected", "trailId": "prospectors-trail", "traceId": "prospectors-trace-1" }, "eventId": "first-trace-inspected" }], "eventIds": ["first-trace-inspected"], "transitions": [{ "nextPhase": "follow-second-trace" }] },
    { "id": "follow-second-trace", "title": "La piste se précise", "description": "Suivez le nouveau marqueur laissé par le groupe disparu.", "objectives": [{ "id": "inspect-second-trace", "text": "Examiner les traces de lutte", "trigger": { "type": "trailPointInspected", "trailId": "prospectors-trail", "traceId": "prospectors-trace-2" }, "eventId": "second-trace-inspected" }], "eventIds": ["second-trace-inspected"], "transitions": [{ "nextPhase": "prospectors-battlefield" }] },
    { "id": "prospectors-battlefield", "title": "Le champ de bataille", "description": "La piste conduit au lieu du dernier combat des prospecteurs.", "objectives": [{ "id": "reach-battlefield", "text": "Atteindre le champ de bataille", "trigger": { "type": "enterLocation", "locationSlotId": "prospectors-battlefield" } }, { "id": "find-mine-report", "text": "Fouiller le champ de bataille", "trigger": { "type": "interactionCompleted", "interactionId": "search-prospectors-battlefield", "locationSlotId": "prospectors-battlefield", "label": "Fouiller le champ de bataille" }, "eventId": "mine-report-found" }], "eventIds": ["mine-report-found"], "transitions": [{ "nextPhase": "free-gold-mine" }] },
    { "id": "free-gold-mine", "title": "La mine occupée", "description": "Les créatures du Chaos contrôlent la mine. Elles doivent être vaincues avant toute recherche.", "objectives": [{ "id": "defeat-mine-chaos", "text": "Attaquer et vaincre les forces du Chaos", "trigger": { "type": "battleWon", "locationSlotId": "gold-mine" }, "eventId": "mine-liberated" }], "eventIds": ["mine-liberated"], "transitions": [{ "nextPhase": "rescue-mine-geologist" }] },
    { "id": "rescue-mine-geologist", "title": "Derrière la porte condamnée", "description": "La mine est désormais sûre. Retrouvez le prisonnier entendu dans les galeries.", "objectives": [{ "id": "rescue-geologist", "text": "Libérer le géologue", "trigger": { "type": "interactionCompleted", "interactionId": "rescue-geologist", "locationSlotId": "gold-mine", "label": "Libérer le géologue" }, "eventId": "geologist-rescued" }], "eventIds": ["geologist-rescued"], "transitions": [{ "nextPhase": "return-geologist-to-camp" }] },
    { "id": "return-geologist-to-camp", "title": "Le seul survivant", "description": "Ramenez le géologue à Valgrise. Armand doit entendre son témoignage et faire établir le rapport final.", "objectives": [{ "id": "complete-mine-report", "text": "Retourner au camp et recevoir le rapport final", "trigger": { "type": "interactionCompleted", "interactionId": "complete-mine-report", "locationSlotId": "royal-camp", "label": "Présenter le géologue à Armand", "responseLines": ["Le géologue confirme que les prospecteurs ont été attaqués par le Chaos.", "Armand rassemble son témoignage et vos découvertes dans un rapport scellé.", "Portez-le sans délai à la capitale."] }, "eventId": "mine-report-completed" }], "eventIds": ["mine-report-completed"], "transitions": [{ "nextPhase": "return-to-capital" }] },
    { "id": "return-to-capital", "title": "Le rapport de la mine", "description": "Portez le rapport final de Valgrise à la capitale royale.", "objectives": [{ "id": "deliver-mine-report", "text": "Remettre le rapport à la capitale", "trigger": { "type": "enterLocation", "locationSlotId": "capital" }, "eventId": "mine-report-delivered" }], "eventIds": ["mine-report-delivered"], "transitions": [] },
    { "id": "prologue-complete", "title": "Un nouvel ordre royal", "description": "Le rapport de Valgrise confirme l’invasion. Présentez-vous au conseil de guerre pour recevoir les ordres du roi.", "objectives": [{ "id": "receive-evacuation-order", "text": "Recevoir le plan d’évacuation du conseil royal", "trigger": { "type": "interactionCompleted", "interactionId": "receive-evacuation-order", "locationSlotId": "capital", "label": "Recevoir le nouvel ordre royal", "responseLines": ["Le conseil de guerre a étudié le rapport de Valgrise : l’attaque de la mine n’était que l’avant-garde d’une invasion.", "Une armée du Chaos a franchi la frontière et marche sur un camp royal où des familles sont encore piégées.", "Le roi vous ordonne de rejoindre ce camp, de repousser les éclaireurs ennemis et d’organiser l’évacuation avant son encerclement.", "Deux chariots royaux sont placés sous votre commandement. Le camp vient d’être signalé sur votre carte : partez sans délai."] }, "eventId": "evacuation-ordered" }], "eventIds": ["evacuation-ordered"], "transitions": [{ "nextPhase": "reach-evacuation-camp" }] },
    { "id": "reach-evacuation-camp", "title": "Le camp menacé", "description": "Rejoignez le camp en vous faufilant entre les patrouilles. Une avant-garde d’une unité de six soldats arrivera dans une minute, puis une armée de quatre unités — vingt-quatre soldats — menacera le camp.", "objectives": [{ "id": "reach-evacuation-camp", "text": "Atteindre le camp avant l’armée principale", "trigger": { "type": "enterLocation", "locationSlotId": "evacuation-camp" }, "eventId": "evacuation-camp-located" }], "eventIds": ["evacuation-camp-located", "evacuation-failed"], "transitions": [{ "nextPhase": "prepare-evacuation" }], "failure": { "policy": "branch", "nextPhase": "evacuation-failed", "eventId": "evacuation-failed" } },
    { "id": "defend-evacuation-camp", "title": "Les éclaireurs du Chaos", "description": "Deux colonnes attaquent par des routes distinctes tandis que des troupes encerclent le camp.", "objectives": [{ "id": "defeat-chaos-scouts", "text": "Vaincre les éclaireurs du Chaos", "trigger": { "type": "battleWon", "locationSlotId": "evacuation-camp" }, "eventId": "evacuation-camp-secured" }], "eventIds": ["evacuation-camp-secured", "evacuation-failed"], "transitions": [{ "nextPhase": "prepare-evacuation" }], "failure": { "policy": "branch", "nextPhase": "evacuation-failed", "eventId": "evacuation-failed" } },
    { "id": "prepare-evacuation", "title": "Sauver ce qui peut l’être", "description": "Affrontez l’avant-garde si nécessaire tout en chargeant le maximum d’habitants et de ressources et en démontant ce que vous pouvez.", "objectives": [{ "id": "depart-evacuation-camp", "text": "Choisir le moment du départ vers la capitale", "trigger": { "type": "evacuationReady", "interactionId": "depart-evacuation-camp", "locationSlotId": "evacuation-camp", "evacuationId": "royal-camp-evacuation", "label": "Quitter le camp avec ce qui a été sauvé" }, "eventId": "evacuation-departed" }], "eventIds": ["evacuation-departed", "evacuation-failed", "evacuation-camp-secured"], "transitions": [{ "nextPhase": "return-evacuees-to-capital" }], "failure": { "policy": "branch", "nextPhase": "evacuation-failed", "eventId": "evacuation-failed" } },
    { "id": "return-evacuees-to-capital", "title": "Le bilan à la capitale", "description": "Ramenez les habitants et les ressources sauvés. C’est uniquement à la capitale que le résultat sera évalué.", "objectives": [{ "id": "deliver-evacuees", "text": "Rejoindre la capitale pour faire évaluer le sauvetage", "trigger": { "type": "enterLocation", "locationSlotId": "capital" }, "eventId": "evacuation-completed" }], "eventIds": ["evacuation-completed", "evacuation-failed"], "transitions": [{ "nextPhase": "second-prologue-complete" }], "failure": { "policy": "branch", "nextPhase": "evacuation-failed", "eventId": "evacuation-failed" } },
    { "id": "second-prologue-complete", "title": "Le prix du salut", "description": "L’évacuation est terminée. Le bilan dépend des habitants, ressources et bâtiments sauvés.", "objectives": [], "eventIds": [], "transitions": [] },
    { "id": "receive-supply-order", "title": "Le ravitaillement", "description": "Les réserves du fortin de Rochegarde s’épuisent. Recevez l’ordre de réunir des vivres dans les villages royaux.", "objectives": [{ "id": "receive-fort-rations", "text": "Recevoir l’ordre de ravitaillement à la capitale", "trigger": { "type": "interactionCompleted", "interactionId": "receive-fort-rations", "locationSlotId": "capital", "label": "Recevoir l’ordre de ravitaillement", "responseLines": ["Le fortin de Rochegarde manque de vivres.", "Quatre villages de la ceinture de la capitale peuvent céder chacun cinq rations.", "Collectez ces réserves puis remettez les vingt rations au commandant du fortin."] }, "eventId": "fort-supply-ordered" }], "eventIds": ["fort-supply-ordered"], "transitions": [{ "nextPhase": "collect-village-rations" }] },
    { "id": "collect-village-rations", "title": "Les greniers du royaume", "description": "Visitez les quatre villages signalés autour de la capitale et récupérez cinq rations dans chacun.", "objectives": [
      { "id": "collect-north-rations", "text": "Collecter 5 rations à Haut-Pré", "trigger": { "type": "resourceCollection", "interactionId": "collect-north-rations", "locationSlotId": "supply-village-north", "resource": "food", "amount": 5, "label": "Charger 5 rations" }, "eventId": "north-rations-collected" },
      { "id": "collect-east-rations", "text": "Collecter 5 rations à Belle-Rive", "trigger": { "type": "resourceCollection", "interactionId": "collect-east-rations", "locationSlotId": "supply-village-east", "resource": "food", "amount": 5, "label": "Charger 5 rations" }, "eventId": "east-rations-collected" },
      { "id": "collect-south-rations", "text": "Collecter 5 rations à Valbois", "trigger": { "type": "resourceCollection", "interactionId": "collect-south-rations", "locationSlotId": "supply-village-south", "resource": "food", "amount": 5, "label": "Charger 5 rations" }, "eventId": "south-rations-collected" },
      { "id": "collect-west-rations", "text": "Collecter 5 rations aux Chasses-Royales", "trigger": { "type": "resourceCollection", "interactionId": "collect-west-rations", "locationSlotId": "supply-village-west", "resource": "food", "amount": 5, "label": "Charger 5 rations" }, "eventId": "west-rations-collected" }
    ], "eventIds": ["north-rations-collected", "east-rations-collected", "south-rations-collected", "west-rations-collected"], "transitions": [{ "nextPhase": "reach-supply-fort" }] },
    { "id": "reach-supply-fort", "title": "La route de Rochegarde", "description": "Transportez les rations jusqu’au fortin royal situé dans la ceinture défensive de la capitale.", "objectives": [{ "id": "reach-supply-fort", "text": "Atteindre le fortin de Rochegarde", "trigger": { "type": "enterLocation", "locationSlotId": "supply-fort" }, "eventId": "supply-fort-reached" }], "eventIds": ["supply-fort-reached"], "transitions": [{ "nextPhase": "deliver-fort-rations" }] },
    { "id": "deliver-fort-rations", "title": "Les réserves du fortin", "description": "Remettez les vingt rations au commandant de Rochegarde.", "objectives": [{ "id": "deliver-fort-rations", "text": "Livrer 20 rations au fortin", "trigger": { "type": "resourceDelivery", "interactionId": "deliver-fort-rations", "locationSlotId": "supply-fort", "playerId": "local", "resource": "food", "amount": 20, "label": "Remettre les rations au seigneur Géraud", "responseLines": ["Le seigneur Géraud fait porter les caisses dans les réserves.", "Les vingt rations sont inventoriées puis distribuées à la garnison.", "Le commandant vous remercie au nom de Rochegarde."] }, "eventId": "fort-rations-delivered" }], "eventIds": ["fort-rations-delivered"], "transitions": [] },
    { "id": "receive-gold-convoy-order", "title": "Le convoi d’or", "description": "La production de la mine royale doit être rapportée à la capitale.", "objectives": [{ "id": "receive-gold-convoy-order", "text": "Recevoir l’ordre du convoi à la capitale", "trigger": { "type": "interactionCompleted", "interactionId": "receive-gold-convoy-order", "locationSlotId": "capital", "label": "Recevoir l’ordre du convoi d’or", "responseLines": ["La mine royale a terminé sa production du mois.", "Récupérez les trente unités d’or et revenez sans délai.", "Des voleurs surveillent les routes : les bandes légères chercheront à vous ralentir, mais leur chef vous donnera la chasse."] }, "eventId": "gold-convoy-ordered" }], "eventIds": ["gold-convoy-ordered"], "transitions": [{ "nextPhase": "collect-royal-gold" }] },
    { "id": "collect-royal-gold", "title": "La production royale", "description": "Rejoignez la mine et prenez en charge sa production d’or.", "objectives": [{ "id": "collect-royal-gold", "text": "Charger 30 unités d’or à la mine royale", "trigger": { "type": "resourceCollection", "interactionId": "collect-royal-gold", "locationSlotId": "royal-gold-mine", "resource": "gold", "amount": 30, "label": "Charger la production d’or" }, "eventId": "royal-gold-collected" }], "eventIds": ["royal-gold-collected"], "transitions": [{ "nextPhase": "escape-gold-thieves" }] },
    { "id": "escape-gold-thieves", "title": "Courez !", "description": "Rapportez l’or à la capitale. Les petites bandes barrent la route pour vous ralentir tandis que le chef voleur vous poursuit.", "objectives": [{ "id": "deliver-royal-gold", "text": "Atteindre la capitale et livrer les 30 unités d’or", "trigger": { "type": "resourceDelivery", "interactionId": "deliver-royal-gold", "locationSlotId": "capital", "playerId": "local", "resource": "gold", "amount": 30, "label": "Mettre l’or à l’abri" }, "eventId": "royal-gold-delivered" }], "eventIds": ["royal-gold-delivered"], "transitions": [] },
    { "id": "receive-fort-message", "title": "Le Messager", "description": "Un ordre urgent doit parvenir au fortin royal situé à l’opposé de Rochegarde.", "objectives": [{ "id": "take-sealed-message", "text": "Prendre le message scellé à Rochegarde", "trigger": { "type": "interactionCompleted", "interactionId": "take-sealed-message", "locationSlotId": "supply-fort", "label": "Recevoir le message urgent", "responseLines": ["Le seigneur Géraud vous remet un pli frappé du sceau royal.", "Ce message doit atteindre Fort-Serein avant l’expiration du délai.", "Le fortin opposé apparaît sur votre carte. Partez immédiatement."] }, "eventId": "sealed-message-taken" }], "eventIds": ["sealed-message-taken"], "transitions": [{ "nextPhase": "deliver-fort-message" }] },
    { "id": "deliver-fort-message", "title": "Course contre la montre", "description": "Transportez le message scellé jusqu’à Fort-Serein avant la fin du temps imparti.", "objectives": [{ "id": "deliver-sealed-message", "text": "Livrer le message à Fort-Serein avant l’expiration du délai", "trigger": { "type": "interactionCompleted", "interactionId": "deliver-sealed-message", "locationSlotId": "opposite-fort", "label": "Remettre le message au commandant", "responseLines": ["Le commandant brise le sceau et lit rapidement l’ordre.", "Les défenses de Fort-Serein seront prêtes à temps.", "Votre célérité a préservé la ligne fortifiée."] }, "eventId": "sealed-message-delivered" }], "eventIds": ["sealed-message-delivered", "sealed-message-expired"], "transitions": [], "failure": { "policy": "branch", "nextPhase": "messenger-failed", "eventId": "sealed-message-expired" } },
    { "id": "messenger-failed", "title": "Message arrivé trop tard", "description": "Le délai est expiré. Fort-Serein n’a pas reçu l’ordre à temps.", "objectives": [], "eventIds": [], "transitions": [] },
    { "id": "evacuation-failed", "title": "Le camp est perdu", "description": "L’évacuation a échoué. Le camp et ses habitants sont abandonnés à l’avancée du Chaos ; aucune récompense n’est accordée.", "objectives": [], "eventIds": [], "transitions": [] },
    { "id": "escape", "title": "La fuite", "description": "Atteignez le refuge.", "objectives": [{ "id": "reach-refuge", "text": "Atteindre le refuge." }], "eventIds": ["refuge-reached"], "transitions": [{ "nextPhase": "installation" }] },
    { "id": "installation", "title": "Installation", "description": "Faites du fort votre base.", "objectives": [{ "id": "secure-refuge", "text": "Sécuriser le refuge." }], "eventIds": ["refuge-secured"], "transitions": [{ "nextPhase": "village" }] },
    { "id": "village", "title": "Le village", "description": "Explorez le village voisin.", "objectives": [{ "id": "reach-village", "text": "Rencontrer les habitants." }], "eventIds": ["village-discovered"], "transitions": [{ "nextPhase": "bandits" }] },
    { "id": "bandits", "title": "Les brigands", "description": "Affrontez la menace locale.", "objectives": [{ "id": "resolve-bandits", "text": "Résoudre la menace des brigands." }], "eventIds": ["bandits-encountered"], "transitions": [{ "nextPhase": "barbarians" }] },
    { "id": "barbarians", "title": "Les barbares", "description": "Une menace plus grande se révèle.", "objectives": [{ "id": "discover-barbarians", "text": "Découvrir les barbares." }], "eventIds": ["barbarians-revealed"], "transitions": [] }
  ],
  "events": [
    { "id": "royal-camp-reached", "effects": [{ "type": "showNarration", "text": "Les sentinelles vous reconnaissent et ouvrent le passage. Le capitaine de Valgrise vous attend." }, { "type": "awardHeroExperience", "playerId": "local", "amount": 10 }] },
    { "id": "camp-chief-questioned", "effects": [{ "type": "showNarration", "text": "Armand vous confie la dernière position connue des prospecteurs." }, { "type": "awardHeroExperience", "playerId": "local", "amount": 10 }] },
    { "id": "first-trace-inspected", "effects": [{ "type": "showNarration", "text": "Des empreintes de bottes et les sillons d’un chariot quittent la route. Parmi elles apparaissent des traces de griffes." }, { "type": "awardHeroExperience", "playerId": "local", "amount": 10 }] },
    { "id": "second-trace-inspected", "effects": [{ "type": "showNarration", "text": "Une sacoche déchirée et des taches de sang jalonnent la piste. Les prospecteurs ont été poursuivis." }, { "type": "awardHeroExperience", "playerId": "local", "amount": 10 }] },
    { "id": "mine-report-found", "effects": [{ "type": "showNarration", "text": "Le silence ne laisse aucun doute : les prospecteurs ont été massacrés par le Chaos. Dans une main crispée, vous trouvez un rapport incomplet indiquant une ancienne mine d’or. Une annotation révèle qu’un géologue y a été emmené vivant." }, { "type": "grantCarriedItem", "playerId": "local", "itemId": "incomplete_mine_report" }, { "type": "revealLocation", "locationSlotId": "gold-mine" }, { "type": "awardHeroExperience", "playerId": "local", "amount": 10 }] },
    { "id": "mine-liberated", "effects": [{ "type": "showNarration", "text": "Les dernières créatures du Chaos s’effondrent. Un appel étouffé résonne derrière une porte condamnée." }, { "type": "awardHeroExperience", "playerId": "local", "amount": 10 }] },
    { "id": "geologist-rescued", "effects": [{ "type": "showNarration", "text": "Vous libérez le géologue royal. Épuisé, il confirme que les prospecteurs ont été attaqués par le Chaos. Ramenez-le au camp de Valgrise pour qu’un rapport complet soit établi." }, { "type": "grantCarriedItem", "playerId": "local", "itemId": "royal_geologist" }, { "type": "awardHeroExperience", "playerId": "local", "amount": 10 }] },
    { "id": "mine-report-completed", "effects": [{ "type": "showNarration", "text": "Le témoignage du géologue confirme le retour des forces du Chaos. Armand vous remet le rapport final scellé destiné à la capitale." }, { "type": "removeCarriedItem", "playerId": "local", "itemId": "incomplete_mine_report" }, { "type": "grantCarriedItem", "playerId": "local", "itemId": "abandoned_mine_report" }, { "type": "awardHeroExperience", "playerId": "local", "amount": 100 }] },
