    { "id": "evacuation-ordered", "effects": [{ "type": "showNarration", "text": "Le camp apparaît sur la carte. Cinq patrouilles agressives forment un cordon laissant un passage étroit. Une avant-garde isolée arrivera dans une minute ; derrière elle, une armée de quatre guerriers avance sur le camp." }, { "type": "revealLocation", "locationSlotId": "evacuation-camp" }, { "type": "assignWagons", "playerId": "local", "wagons": [{ "id": "royal-wagon-1", "name": "Chariot royal I", "slotBonus": 4 }, { "id": "royal-wagon-2", "name": "Chariot royal II", "slotBonus": 4 }] }, { "type": "startEvacuation", "evacuationId": "royal-camp-evacuation", "simulationDurationMinutes": 3, "deadlineCausesFailure": false, "sourceLocationSlotId": "evacuation-camp", "timing": { "originLocationSlotId": "capital", "baseMinutes": 2, "minimumMinutes": 3, "maximumMinutes": 12, "calmMetersPerMinute": 60, "sportMetersPerMinute": 100 } }, { "type": "spawnAttackGroup", "groupId": "chaos-cordon-0", "factionId": "chaos", "targetLocationSlotId": "evacuation-camp", "originDistanceMeters": 18, "simulationDistanceUnits": 14, "directionDegrees": 0, "stationary": true, "engagementRadiusMeters": 12, "simulationEngagementRadiusUnits": 10, "unitTypeId": "chaos-raider", "quantity": 2 }, { "type": "spawnAttackGroup", "groupId": "chaos-cordon-60", "factionId": "chaos", "targetLocationSlotId": "evacuation-camp", "originDistanceMeters": 18, "simulationDistanceUnits": 14, "directionDegrees": 60, "stationary": true, "engagementRadiusMeters": 12, "simulationEngagementRadiusUnits": 10, "unitTypeId": "chaos-raider", "quantity": 2 }, { "type": "spawnAttackGroup", "groupId": "chaos-cordon-120", "factionId": "chaos", "targetLocationSlotId": "evacuation-camp", "originDistanceMeters": 18, "simulationDistanceUnits": 14, "directionDegrees": 120, "stationary": true, "engagementRadiusMeters": 12, "simulationEngagementRadiusUnits": 10, "unitTypeId": "chaos-raider", "quantity": 2 }, { "type": "spawnAttackGroup", "groupId": "chaos-